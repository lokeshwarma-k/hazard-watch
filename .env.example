# Required in production. The ESP32 must send this value in the x-api-key header.
INGEST_KEY=change-me-to-a-long-random-string

# Render Postgres connection string (set automatically by render.yaml).
# If unset in local development, readings are stored in ./data.json instead.
DATABASE_URL=

PORT=3000
# NODE_ENV=production

# Optional
# OFFLINE_AFTER_MS=10000
# RETENTION_DAYS=14
# DEFAULT_NODE_ID=esp32-01
# CORS_ORIGIN=https://your-frontend.example      # only if frontend is hosted elsewhere
# Real node coordinates (the map shows a marker only when these are set or sent by the node):
# NODE_LAT=
# NODE_LON=
# NODE_LOCATIONS={"esp32-01":{"lat":12.9716,"lon":77.5946}}
# Override demonstration thresholds (see server/config.js for keys):
# THRESHOLDS_JSON={"flood":{"warnBelowCm":40,"dangerBelowCm":20}}
